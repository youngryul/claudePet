{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Coding Pet",
  "version": "0.1.8",
  "identifier": "dev.aicodingpet.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "title": "AI Coding Pet",
        "url": "index.html",
        "width": 220,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "A desktop pet that reacts to your AI coding agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMzM2RTZCMjdCRDJCQzgKUldUSUs3MG5hMjR6MisxYkxZNXZTdHF3eVF3ZzV3TmZhSTBpWWNPTGR3R3R3dUUwL1J2dWlnSjIK",
      "endpoints": ["https://github.com/youngryul/claudePet/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
